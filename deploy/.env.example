# Copy to .env on the monitoring server (deploy.yml writes it from secrets).
SRVMON_DOMAIN=mon.example.com
# Image tag to run; CI sets it to the commit sha on deploy.
SRVMON_TAG=latest
SRVMON_RETENTION=90d
# caddy (bundled Caddy on 80/443) or external (your own reverse proxy).
SRVMON_PROXY=caddy
# Where srvmon-server listens on the host for an external proxy.
SRVMON_HTTP_BIND=127.0.0.1:8088
# Name of the monitoring host in the panel (remote-deploy.sh sets hostname).
#SRVMON_SELF_NAME=monitor
# Pull credentials for the agent image when the add wizard installs it on
# a server. Not needed if the srvmon-agent package on GHCR is public.
#SRVMON_AGENT_REGISTRY_USER=askidmobile
#SRVMON_AGENT_REGISTRY_TOKEN=ghp_xxx  (PAT with read:packages only)
